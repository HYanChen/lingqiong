FROM maven:3.9.11-eclipse-temurin-17 AS builder

WORKDIR /source
COPY vendor/jeecg-boot/jeecg-boot/ ./
RUN --mount=type=cache,id=lingqiong-maven-cache,target=/root/.m2 \
    mvn -Pdocker -pl jeecg-module-system/jeecg-system-start -am -DskipTests clean package

FROM eclipse-temurin:17-jre-jammy
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Asia/Shanghai
WORKDIR /app
COPY --from=builder /source/jeecg-module-system/jeecg-system-start/target/jeecg-system-start-3.9.3.jar /app/jeecg-system.jar
EXPOSE 8080
ENTRYPOINT ["java", "-Dfile.encoding=UTF-8", "-jar", "/app/jeecg-system.jar"]
